# Campus Lost & Found settings. Lines starting with # are ignored.
# Restart the app after changing this file.

# Name shown in the site header
CAMPUS_NAME=Campus

# Port to run on
PORT=5000

# development = codes are printed in the terminal. production = needs real SMTP + SECRET_KEY.
APP_ENV=development

# Session signing key. Change this to any long random text.
SECRET_KEY=

# Admin password, used ONLY when the database is created for the first time.
# Min 8 characters, with a letter and a number.
ADMIN_PASSWORD=

# Email (leave SMTP_HOST empty in development; codes will print in the terminal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# New reports wait for staff approval before they are public. Set to 0 to publish immediately.
MODERATION_REQUIRED=1
